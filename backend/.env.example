# Server
PORT=5000
NODE_ENV=development

# MongoDB (local ya MongoDB Atlas ka connection string)
MONGO_URI=mongodb://127.0.0.1:27017/food-delivery

# Frontend URL(s) jo API call kar sakte hain (comma separated)
CLIENT_URL=http://localhost:3000

# Order status simulation: har step ke beech kitne ms wait kare
SIMULATE_STATUS=true
STATUS_STEP_MS=15000

# Optional: set karoge to PATCH /orders/:id/status ke liye header "x-admin-key" zaroori hoga
ADMIN_API_KEY=
